<COMMIT_POLICY_V1>
  <PROJECT_IDENTITY>
    <PROJECT_NAME>paseo</PROJECT_NAME>
    <PROJECT_TYPE>typescript-project</PROJECT_TYPE>
    <ARCHITECTURE_STYLE>workspace-oriented</ARCHITECTURE_STYLE>
    <PRIMARY_LANGUAGE>typescript</PRIMARY_LANGUAGE>
    <MONOREPO>true</MONOREPO>
  </PROJECT_IDENTITY>

  <POLICY_META>
    <VERSION>1</VERSION>
    <SOURCE>repo</SOURCE>
    <POLICY_PATH>.agents/rules/commit-policy.xml</POLICY_PATH>
  </POLICY_META>

  <SCOPE_POLICY>
    <STRICT_SCOPES>false</STRICT_SCOPES>
    <SCOPE_VOCABULARY>
      <SCOPE>app</SCOPE>
      <SCOPE>server</SCOPE>
      <SCOPE>cli</SCOPE>
      <SCOPE>client</SCOPE>
      <SCOPE>protocol</SCOPE>
      <SCOPE>relay</SCOPE>
      <SCOPE>desktop</SCOPE>
      <SCOPE>website</SCOPE>
      <SCOPE>highlight</SCOPE>
      <SCOPE>audio</SCOPE>
      <SCOPE>docs</SCOPE>
      <SCOPE>agents</SCOPE>
      <SCOPE>scripts</SCOPE>
      <SCOPE>docker</SCOPE>
      <SCOPE>nix</SCOPE>
      <SCOPE>build</SCOPE>
      <SCOPE>repo</SCOPE>
    </SCOPE_VOCABULARY>
    <PATH_SCOPE_MAPPINGS>
      <MAP>
        <PATH_GLOB>packages/app/**</PATH_GLOB>
        <SCOPE>app</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>packages/server/**</PATH_GLOB>
        <SCOPE>server</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>packages/cli/**</PATH_GLOB>
        <SCOPE>cli</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>packages/client/**</PATH_GLOB>
        <SCOPE>client</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>packages/protocol/**</PATH_GLOB>
        <SCOPE>protocol</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>packages/relay/**</PATH_GLOB>
        <SCOPE>relay</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>packages/desktop/**</PATH_GLOB>
        <SCOPE>desktop</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>packages/website/**</PATH_GLOB>
        <SCOPE>website</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>packages/highlight/**</PATH_GLOB>
        <SCOPE>highlight</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>packages/expo-two-way-audio/**</PATH_GLOB>
        <SCOPE>audio</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>docs/**</PATH_GLOB>
        <SCOPE>docs</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>public-docs/**</PATH_GLOB>
        <SCOPE>docs</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>README*.md</PATH_GLOB>
        <SCOPE>docs</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>SECURITY.md</PATH_GLOB>
        <SCOPE>docs</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>CONTRIBUTING.md</PATH_GLOB>
        <SCOPE>docs</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>CHANGELOG.md</PATH_GLOB>
        <SCOPE>docs</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>.agents/**</PATH_GLOB>
        <SCOPE>agents</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>.claude/**</PATH_GLOB>
        <SCOPE>agents</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>.codex/**</PATH_GLOB>
        <SCOPE>agents</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>skills/**</PATH_GLOB>
        <SCOPE>agents</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>scripts/**</PATH_GLOB>
        <SCOPE>scripts</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>docker/**</PATH_GLOB>
        <SCOPE>docker</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>nix/**</PATH_GLOB>
        <SCOPE>nix</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>flake.nix</PATH_GLOB>
        <SCOPE>nix</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>flake.lock</PATH_GLOB>
        <SCOPE>nix</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>package.json</PATH_GLOB>
        <SCOPE>build</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>package-lock.json</PATH_GLOB>
        <SCOPE>build</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>tsconfig*.json</PATH_GLOB>
        <SCOPE>build</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>vitest.config.ts</PATH_GLOB>
        <SCOPE>build</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>lefthook.yml</PATH_GLOB>
        <SCOPE>build</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>knip.json</PATH_GLOB>
        <SCOPE>build</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>patches/**</PATH_GLOB>
        <SCOPE>build</SCOPE>
      </MAP>
      <MAP>
        <PATH_GLOB>paseo.json</PATH_GLOB>
        <SCOPE>build</SCOPE>
      </MAP>
    </PATH_SCOPE_MAPPINGS>
  </SCOPE_POLICY>

  <BODY_POLICY>
    <ENABLE_BODY>true</ENABLE_BODY>
    <PREFER_BODY_FOR_SUPPORTING_DETAILS>true</PREFER_BODY_FOR_SUPPORTING_DETAILS>
    <REQUIRE_BODY_WHEN>summary alone is not sufficiently precise</REQUIRE_BODY_WHEN>
    <REQUIRE_BODY_WHEN>multiple related changes support one capability</REQUIRE_BODY_WHEN>
    <BODY_STYLE>
      <RULE>explain what changed and why it matters</RULE>
      <RULE>keep supporting detail in the body instead of the subject</RULE>
      <RULE>format the body as a flat bullet list when it contains more than one supporting change</RULE>
      <RULE>use one bullet per distinct supporting change</RULE>
      <RULE>keep each bullet concise and factual</RULE>
    </BODY_STYLE>
  </BODY_POLICY>

  <FOOTER_REQUIREMENTS>
    <ISSUE_FOOTER_ENABLED>false</ISSUE_FOOTER_ENABLED>
    <ISSUE_FOOTER_FORMAT>Refs: {{ISSUE_KEY}}</ISSUE_FOOTER_FORMAT>
    <BREAKING_CHANGE_ENABLED>true</BREAKING_CHANGE_ENABLED>
  </FOOTER_REQUIREMENTS>

  <BRANCH_ISSUE_EXTRACTION_RULES>
    <ENABLED>false</ENABLED>

    <NORMALIZATION>
      <UPPERCASE>true</UPPERCASE>
      <TRIM_WHITESPACE>true</TRIM_WHITESPACE>
    </NORMALIZATION>
  </BRANCH_ISSUE_EXTRACTION_RULES>

  <GRACE_HINTS>
    <ENABLED>false</ENABLED>
    <APPLICATION_GRAPH_PATH>AppGraph.xml</APPLICATION_GRAPH_PATH>
    <PACKAGE_CONTRACT_HINTS_ENABLED>true</PACKAGE_CONTRACT_HINTS_ENABLED>
    <PREFER_GRAPH_MODULE_NAMES>true</PREFER_GRAPH_MODULE_NAMES>
  </GRACE_HINTS>

  <DISCOVERY_RULES>
    <FALLBACK_TO_GENERIC_IF_MISSING>true</FALLBACK_TO_GENERIC_IF_MISSING>
    <WARN_IF_POLICY_MISSING>true</WARN_IF_POLICY_MISSING>
    <ALLOW_RUNTIME_ENRICHMENT>true</ALLOW_RUNTIME_ENRICHMENT>
  </DISCOVERY_RULES>
</COMMIT_POLICY_V1>
